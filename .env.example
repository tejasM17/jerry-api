PORT=5000
NODE_ENV=development

# Gemini (required for chat generation)
GEMINI_API_KEY=your_gemini_api_key
# Optional rotation: GEMINI_API_KEYS=key1,key2
# Optional: GEMINI_MODEL=gemini-2.5-flash

# CORS — production must be the Vercel origin with no trailing slash
FRONTEND_URL=http://localhost:5173
# Optional comma-separated extra origins
# CORS_ORIGINS=https://another-preview.vercel.app
# ALLOW_VERCEL_PREVIEWS=true

# Firebase Admin SDK (Render dashboard). Keep FIREBASE_PRIVATE_KEY quoted;
# keep \n as escaped newlines in a single line.
FIREBASE_PROJECT_ID=jerry999-a281d
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@jerry999-a281d.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# MongoDB Atlas
MONGODB_URI=your_mongodb_connection_string
# Optional if URI contains the literal <db_password> placeholder:
# MONGODB_PASSWORD=your_atlas_db_password
# MONGODB_DB_NAME=jerry
