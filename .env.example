PORT=5000
GEMINI_API_KEY=your_gemini_api_key
# Optional: GEMINI_API_KEYS=key1,key2  (rotation)
# Optional: GEMINI_MODEL=gemini-2.5-flash
FRONTEND_URL=http://localhost:5173

# Clerk (required for API auth — frontend sends session JWT via Authorization: Bearer)
# Firebase Auth switch – set to true to use Firebase ID tokens instead of Clerk JWTs
USE_FIREBASE_AUTH=false
# Firebase Admin SDK service account (keep FIREBASE_PRIVATE_KEY quoted; keep \n as escaped newlines)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=your_service_account_email
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
# Optional comma-separated extra origins allowed on session JWTs (azp)
# CLERK_AUTHORIZED_PARTIES=https://app.example.com
#
# Optional (Dashboard): Session token custom claim for faster ownership resolve:
#   { "userId": "{{user.external_id || user.id}}" }

# MongoDB Atlas — chats, messages, users, GridFS uploads
# Either a full URI, or URI with <db_password> + MONGODB_PASSWORD
MONGODB_URI=mongodb://jerry-files:<db_password>@ac-tni5j6m-shard-00-00.qgtrwl5.mongodb.net:27017,ac-tni5j6m-shard-00-01.qgtrwl5.mongodb.net:27017,ac-tni5j6m-shard-00-02.qgtrwl5.mongodb.net:27017/?ssl=true&replicaSet=atlas-j4r3wv-shard-0&authSource=admin&appName=contact-manager-clutster
MONGODB_PASSWORD=your_atlas_db_password
